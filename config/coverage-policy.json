{
  "schema": "mosaic-coverage-policy-v1",
  "scope": {
    "include": [
      "rtl/*.sv",
      "verif/coverage/*.sv",
      "verif/coverage/*.svh"
    ]
  },
  "thresholds": {
    "line": 90,
    "branch": 90,
    "toggle": 90,
    "user": 100
  },
  "coverpoints": [
    {"name": "accepted_write", "minimum_hits": 1},
    {"name": "observed_full", "minimum_hits": 1},
    {"name": "accepted_read", "minimum_hits": 1},
    {"name": "stalled_output", "minimum_hits": 1},
    {"name": "observed_empty", "minimum_hits": 1}
  ],
  "exclusions": [],
  "formal": {
    "required": true
  }
}
