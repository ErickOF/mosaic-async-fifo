            "i_w_data",
            "i_w_rstb",
            "i_r_ready",
            "i_r_rstb"
          ],
          "output_delay": [
            "o_w_ready",
            "o_w_full",
            "o_w_almost_full",
            "o_w_level",
            "o_w_init_done",
            "o_r_valid",
            "o_r_data",
            "o_r_empty",
            "o_r_almost_empty",
            "o_r_level",
            "o_r_init_done"
          ]
        },
        "clocks": [
          {
            "name": "w_clk",
            "period": 10,
            "port": "i_w_clk"
          },
          {
            "name": "r_clk",
            "period": 14,
            "port": "i_r_clk"
          }
        ],
        "intentional_exceptions": []
      }
    ]
  },
  "upf": {
