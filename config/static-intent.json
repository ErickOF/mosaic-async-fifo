      ],
      "supply_ports": [
        "VDD",
        "VSS"
      ],
      "supply_nets": [
        "VDD",
        "VSS"
      ],
      "supply_connections": [
        "VDD",
        "VSS"
      ],
      "domain_supplies": [
        "PD_ASYNC_FIFO"
      ]
    },
    "forbidden_strategies": [
      "isolation",
      "retention",
      "level_shifter",
      "power_switch"
    ]
  }
}
