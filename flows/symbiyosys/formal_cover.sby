[options]
mode cover
depth 128
timeout 600
multiclock on

[engines]
smtbmc bitwuzla

[script]
read -formal -D MOSAIC_FORMAL -D MOSAIC_YOSYS_FORMAL -sv dff.sv counter.sv async_fifo_capture_formal.sv async_fifo.sv async_fifo_sva.sv async_fifo_coverage.sv async_fifo_formal.sv
prep -top async_fifo_formal -flatten

[files]
submodules/mosaic-common/rtl/dff.sv
submodules/mosaic-common/rtl/counter.sv
rtl/async_fifo.sv
verif/properties/async_fifo_predicates.svh
verif/assertions/async_fifo_sva.sv
verif/coverage/async_fifo_coverage.sv
verif/formal/async_fifo_formal.sv
verif/formal/async_fifo_capture_formal.sv
