set_design_top mosaic_module

create_power_domain PD_MOSAIC_MODULE -include_scope
create_supply_port VDD -domain PD_MOSAIC_MODULE
create_supply_port VSS -domain PD_MOSAIC_MODULE
create_supply_net VDD -domain PD_MOSAIC_MODULE
create_supply_net VSS -domain PD_MOSAIC_MODULE
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_MOSAIC_MODULE -primary_power_net VDD -primary_ground_net VSS

