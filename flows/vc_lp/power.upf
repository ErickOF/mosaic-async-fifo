set_design_top async_fifo
create_power_domain PD_ASYNC_FIFO -include_scope
create_supply_port VDD -domain PD_ASYNC_FIFO
create_supply_port VSS -domain PD_ASYNC_FIFO
create_supply_net VDD -domain PD_ASYNC_FIFO
create_supply_net VSS -domain PD_ASYNC_FIFO
connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
set_domain_supply_net PD_ASYNC_FIFO -primary_power_net VDD -primary_ground_net VSS
# Same-voltage, always-on draft. No switchable-domain behavior is implemented.
# Voltage crossings and unilateral power loss require new qualified intent.
